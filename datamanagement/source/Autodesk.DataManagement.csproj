<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>Autodesk Platform Services SDK Team</Authors>
    <PackageDescription>Client SDK for Data Management API</PackageDescription>
    <PackageReleaseNotes>Added support for the full Data Management filtering syntax - comparison operators, multiple filters, abbreviated field names, and date/timestamp normalization - across all twelve filter-bearing operations. Each operation gains a `filters` overload alongside the existing signature, plus the new `QueryFilter`, `ComparisonType`, and `DataManagementFields` types. Existing signatures are unchanged, so already-compiled callers keep working - not a binary breaking change. Two source-level notes: a call that passed a literal `null` positionally where `filters` now sits becomes ambiguous and needs a named argument or a cast, and types that implement the `I*Api` interfaces directly must implement the new overloads.</PackageReleaseNotes>
    <Copyright>Autodesk Inc.</Copyright>
    <PackageId>Autodesk.DataManagement</PackageId>
    <PackageVersion>2.2.0</PackageVersion>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>autodesk-icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/autodesk-platform-services/aps-sdk-net.git</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autodesk.SDKManager" />
    <None Include="../../LICENSE.txt" Pack="true" PackagePath=""/>
    <None Include="../../README.md" Pack="true" PackagePath=""/>
    <None Include="../../images/autodesk-icon.png" Pack="true" PackagePath=""/>
  </ItemGroup>
</Project>